{% extends "base.html" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="text-center mb-4" data-aos="fade-down">
        <h2
            style="font-weight: 700; background: linear-gradient(135deg, #ff1493, #ff8c00); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            🎁 Our Gift Collection</h2>
        <p style="color: #7f8c8d;">Browse our beautiful gifts for every occasion.</p>
    </div>

    <div class="row">
        <!-- Filter Sidebar -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="filter-sidebar" data-aos="fade-right">
                <h5 class="filter-title">🔍 Filters</h5>

                <form method="GET" action="{% url 'shop' %}" id="filterForm">
                    <!-- Search Box -->
                    <div class="filter-section">
                        <label class="filter-label">Search Products</label>
                        <input type="text" name="search" class="form-control filter-input"
                            placeholder="Search by name..." value="{{ search_query|default:'' }}">
                    </div>

                    <!-- Category Filter -->
                    <div class="filter-section">
                        <label class="filter-label">Category</label>
                        <select name="category" class="form-select filter-select">
                            <option value="">All Categories</option>
                            {% for category in categories %}
                            <option value="{{ category.id }}" {% if selected_category==category.id %}selected{% endif
                                %}>
                                {{ category.name }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Price Range Filter -->
                    <div class="filter-section">
                        <label class="filter-label">Price Range</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="min_price" class="form-control filter-input"
                                    placeholder="Min" value="{{ min_price|default:'' }}" min="0" step="0.01">
                            </div>
                            <div class="col-6">
                                <input type="number" name="max_price" class="form-control filter-input"
                                    placeholder="Max" value="{{ max_price|default:'' }}" min="0" step="0.01">
                            </div>
                        </div>
                    </div>

                    <!-- Sort By -->
                    <div class="filter-section">
                        <label class="filter-label">Sort By</label>
                        <select name="sort" class="form-select filter-select">
                            <option value="">Default</option>
                            <option value="price_low" {% if sort_by=='price_low' %}selected{% endif %}>Price: Low to
                                High</option>
                            <option value="price_high" {% if sort_by=='price_high' %}selected{% endif %}>Price: High to
                                Low</option>
                            <option value="newest" {% if sort_by=='newest' %}selected{% endif %}>Newest First</option>
                            <option value="name" {% if sort_by=='name' %}selected{% endif %}>Name (A-Z)</option>
                        </select>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="filter-buttons">
                        <button type="submit" class="btn btn-apply-filter">Apply Filters</button>
                        <a href="{% url 'shop' %}" class="btn btn-clear-filter">Clear All</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-lg-9 col-md-8">
            <div class="row g-3">
                {% for product in products %}
                <div class="col-lg-4 col-md-6 col-sm-6" data-aos="zoom-in" data-aos-delay="{{ forloop.counter }}00">
                    <div class="product-card">
                        <div class="product-image-wrapper">
                            <img src="{{ product.image.url }}" class="product-image" alt="{{ product.name }}">
                        </div>
                        <div class="product-body">
                            <h6 class="product-title">{{ product.name }}</h6>
                            <p class="product-description">{{ product.description|truncatewords:8 }}</p>
                            <p class="product-price">${{ product.price }}</p>
                            <div class="product-actions">
                                <a href="{% url 'checkout' product.id %}" class="btn btn-buy">Buy Now</a>
                                <form method="POST" action="{% url 'add_to_cart' product.id %}" style="display:inline;">
                                    {% csrf_token %}
                                    <button type="submit" class="btn btn-cart">
                                        <i class="fas fa-cart-plus"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% empty %}
                <div class="col-12 text-center">
                    <div class="no-products">
                        <i class="fas fa-search" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
                        <p style="color: #95a5a6; font-size: 1.2rem;">No products found matching your filters.</p>
                        <a href="{% url 'shop' %}" class="btn btn-clear-filter">Clear Filters</a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<style>
    /* Filter Sidebar Styles */
    .filter-sidebar {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        position: sticky;
        top: 20px;
    }

    .filter-title {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 3px solid #ff1493;
        background: linear-gradient(135deg, #ff1493, #ff8c00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .filter-section {
        margin-bottom: 20px;
    }

    .filter-label {
        font-weight: 600;
        color: #34495e;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
    }

    .filter-input,
    .filter-select {
        border: 2px solid #e8e8e8;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .filter-input:focus,
    .filter-select:focus {
        border-color: #ff1493;
        box-shadow: 0 0 0 0.2rem rgba(255, 20, 147, 0.15);
        outline: none;
    }

    .filter-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-apply-filter {
        background: linear-gradient(135deg, #ff1493, #ff69b4);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn-apply-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 20, 147, 0.4);
        color: white;
    }

    .btn-clear-filter {
        background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-clear-filter:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(127, 140, 141, 0.4);
        color: white;
    }

    /* Product Card Styles */
    .product-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(255, 20, 147, 0.2);
    }

    .product-image-wrapper {
        position: relative;
        overflow: hidden;
        height: 180px;
        background: linear-gradient(135deg, #ffeef8, #fff5f7);
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.1);
    }

    .product-body {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .product-title {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .product-description {
        color: #7f8c8d;
        font-size: 0.8rem;
        margin-bottom: 10px;
        flex: 1;
        line-height: 1.4;
    }

    .product-price {
        font-weight: 700;
        font-size: 1.1rem;
        color: #ff1493;
        margin-bottom: 12px;
    }

    .product-actions {
        display: flex;
        gap: 8px;
    }

    .btn-buy {
        flex: 1;
        background: linear-gradient(135deg, #ff1493, #ff69b4);
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-buy:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 20, 147, 0.4);
        color: white;
    }

    .btn-cart {
        background: linear-gradient(135deg, #ffd700, #ff8c00);
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-cart:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 140, 0, 0.4);
    }

    .btn-cart i {
        font-size: 1rem;
    }

    .no-products {
        padding: 60px 20px;
        text-align: center;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
        .filter-sidebar {
            position: relative;
            top: 0;
        }
    }

    @media (max-width: 768px) {
        .product-image-wrapper {
            height: 150px;
        }

        .filter-sidebar {
            margin-bottom: 20px;
        }
    }
</style>
{% endblock %}